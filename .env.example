DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# Option A: one database URL
DATABASE_URL=

# Option B: separate values
DB_NAME=ai_assistant
DB_USER=postgres
DB_PASSWORD=
